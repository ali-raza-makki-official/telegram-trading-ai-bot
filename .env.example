# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ADMIN_CHAT_ID=123456789

# MetaApi Cloud Configuration (https://metaapi.cloud/docs/client/websocket/overview/)
METAAPI_API_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# LLM Providers Configuration ("gemini" | "claude" | "deepseek" | "hybrid")
LLM_PRIMARY_PROVIDER=deepseek

# DeepSeek Configuration (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat # "deepseek-chat" (DeepSeek V3) or "deepseek-reasoner" (DeepSeek R1)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash # or gemini-2.5-pro

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System & Autonomy Settings
AUTONOMY_MODE=semi # "auto" | "semi" | "manual"
EXECUTION_MODE=metaapi # "paper" | "metaapi" | "mt5"
LOG_LEVEL=info # "trace" | "debug" | "info" | "warn" | "error"

# Database Configuration
DB_TYPE=sqlite # "sqlite" | "mysql"
SQLITE_DB_PATH=./data/trading_agent.json
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=gold_trading_bot

# Risk Management
ACCOUNT_STARTING_BALANCE=10000
RISK_PERCENT_PER_TRADE=1.0 # 1% of account equity
MAX_LOT_SIZE=1.0
MAX_DAILY_LOSS_PERCENT=3.0 # Stop trading for the day if 3% loss is reached
MAX_CONCURRENT_POSITIONS=3
MANDATORY_STOP_LOSS=true
MIN_RISK_REWARD_RATIO=1.5
FRIDAY_CLOSE_BUFFER_MINUTES=60 # Pause entries 60m before Friday NY close

# Strategy & Confluence Thresholds
MIN_CONFLUENCE_SCORE=65 # 0-100 threshold to escalate to LLM / signal
HIGH_CONFIDENCE_THRESHOLD=80
PRIMARY_SYMBOL=XAUUSD
TIME_FRAMES=1m,5m,15m,1h,4h,1d
